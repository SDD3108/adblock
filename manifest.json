{
  "manifest_version": 3,
  "name": "AdBlock — block ads across the web",
  "version": "6.47.0",
  "description": "Block ads on YouTube and your favorite sites for free",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "offscreen"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "AdBlock", "default_popup": "popup.html", "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "options_page": "options.html",
  "commands": {"select-area": {"suggested_key": {"default": "Ctrl+Shift+S", "mac": "Command+Shift+S"}, "description": "Выделить область страницы"}},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src https://generativelanguage.googleapis.com; img-src 'self' data: blob:"}
}
